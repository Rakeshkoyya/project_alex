# ---- Model provider (pick one). OpenRouter is the default when its key is set.
OPENROUTER_API_KEY=sk-or-v1-...
ALEX_MODEL=deepseek/deepseek-v4-flash
# Optional per-role override, e.g. a stronger model for the Advisor:
# ALEX_MODEL_ADVISOR=deepseek/deepseek-v4-pro
# ANTHROPIC_API_KEY=sk-ant-...      # alternative provider (ALEX_PROVIDER=anthropic)
# ALEX_PROVIDER=openrouter          # openrouter | anthropic | demo (auto-detected if unset)

# ---- Web search: set BOTH for the strongest Librarian. They run in parallel, results are merged
# and cross-checked; if one fails the other carries on; with neither, Wikipedia is used.
BRAVE_API_KEY=
TAVILY_API_KEY=
# ALEX_TAVILY_DEPTH=basic                       # basic (1 credit/search) | advanced (2 credits, deeper)
# ALEX_SEARCH_ENGINES=brave,tavily              # restrict or reorder engines

# ---- Access. Default: open to everyone, no login (each browser gets its own private courses).
# ALEX_REQUIRE_LOGIN=true                       # optional: username/password accounts instead
# ALEX_ALLOW_SIGNUP=false                       # (accounts mode) close registration

# ---- Storage (the Docker image sets these)
# ALEX_DATA_DIR=/data
# PORT=8787
