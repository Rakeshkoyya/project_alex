{
  "name": "project-alex",
  "version": "0.1.0",
  "private": true,
  "description": "Project Alex \u2014 a ZPD-driven AI university for self-learners, built on the Pi agent harness.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:pi && vite build --config web/vite.config.ts",
    "start": "tsx server/src/index.ts",
    "typecheck": "tsc -p packages/alex-harness/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "node --import tsx --test packages/alex-harness/test/*.test.ts server/test/*.test.ts",
    "build:pi": "node scripts/build-pi.mjs",
    "postinstall": "node scripts/build-pi.mjs --if-needed"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@alex/harness": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "typebox": "^1.3.34",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "workspaces": [
    "vendor/pi-mono/packages/*",
    "packages/*"
  ]
}
